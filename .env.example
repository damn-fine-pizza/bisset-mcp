# BissetMCP Configuration
# Copy to .env and fill in your values

# SQLite database file path. If unset, defaults to ~/.bisset/bisset.db
DATABASE_PATH=./orchestrator/workflow_server/workflow.db

# HTTP port for the workflow server (used by scripts/server.sh)
WORKFLOW_SERVER_PORT=8765

# URL the STDIO MCP proxy uses to reach the workflow server
WORKFLOW_BACKEND_URL=http://127.0.0.1:8765
