# Copy to .env and fill in your values

# If you want agents to call an external LLM, set this key. Otherwise leave blank and set USE_LLM=false
OPENAI_API_KEY=sk-...

# Fallback mode: when USE_LLM=false agents will return static templates from prompts/ instead of calling external APIs
USE_LLM=false
# Directory (relative to each agent service) where prompt templates live
PROMPTS_DIR=./prompts

# Optional overrides
# LLM_MODEL=gpt-4o
# MCP_CONTEXT_URL=http://localhost:3000
# ORCHESTRATOR_PORT=8080
