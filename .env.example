# BissetMCP Configuration
# Copy to .env and fill in your values

# SQLite database file path (created automatically)
DATABASE_PATH=./orchestrator/workflow_server/workflow.db

# HTTP port for the workflow server
WORKFLOW_SERVER_PORT=8765

# Set to 1 for pretty-printed JSON logs; 0 for compact (production)
WORKFLOW_PRETTY_JSON_LOGS=1

# Minimum Gherkin scenario pass rate to advance past the coverage phase (%)
BDD_COVERAGE_THRESHOLD=80

# URL the STDIO MCP proxy uses to reach the workflow server
MCP_SERVER_HOST=http://localhost:8765
